{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
      ],
      "passThroughEnv": [
        "SUPABASE_SERVICE_ROLE_KEY",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "RESEND_SECURITY_FROM_EMAIL",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "INFOBIP_BASE_URL",
        "INFOBIP_API_KEY",
        "INFOBIP_SMS_SENDER",
        "OTP_PEPPER",
        "COOKIE_DOMAIN",
        "VERCEL_ENV",
        "AUTH_DISABLE_RATE_LIMITS",
        "AUTH_SMS_PROVIDER",
        "AUTH_MOCK_SMS_CODE"
      ]
    },
    "start": {
      "passThroughEnv": [
        "SUPABASE_SERVICE_ROLE_KEY",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "RESEND_SECURITY_FROM_EMAIL",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "INFOBIP_BASE_URL",
        "INFOBIP_API_KEY",
        "INFOBIP_SMS_SENDER",
        "OTP_PEPPER",
        "COOKIE_DOMAIN",
        "VERCEL_ENV",
        "AUTH_DISABLE_RATE_LIMITS",
        "AUTH_SMS_PROVIDER",
        "AUTH_MOCK_SMS_CODE"
      ]
    }
  }
}
